# Copy to .env and fill in. Never commit .env.

# Application
PORT=3000
# Public URL of the web app (CORS origin, links in emails)
APP_URL=http://localhost:5173
# Secure __Host- session cookie. Chromium/Firefox accept it on http://localhost;
# set to false only for plain-HTTP development in Safari.
# COOKIE_SECURE=true

# MongoDB credentials
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# Database
MONGO_DATABASE=chores

# Shared secret between backend and mailer (internal only), at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MAILER_KEY=

# Email delivery (SMTP provider, sender address) is configured in mailer/.env;
# see mailer/.env.example. Without it, all mail goes to the Mailpit test inbox.
