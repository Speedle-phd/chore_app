# Mailer settings. Copy to mailer/.env and fill in. Never commit mailer/.env.
#
# Leave everything commented out in development: mail then goes to the
# Mailpit test inbox (http://localhost:8025) and nobody receives anything.
#
# MAILER_KEY is NOT set here: the backend needs the same value, so it lives in
# the root .env and Compose passes it to both services.

# --- SMTP server of your email provider (e.g. Postmark, Amazon SES, Mailgun, Brevo, Resend)
# SMTP_HOST=smtp.yourprovider.com
# Port 587 with STARTTLS. (Port 465 / implicit TLS is not supported yet.)
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USER=
# SMTP_PASSWORD=

# --- Sender. Use an address on your own domain and set up SPF, DKIM and DMARC
# for it with your provider, or mail will land in spam.
# MAIL_FROM=Hearth <no-reply@yourdomain.com>
