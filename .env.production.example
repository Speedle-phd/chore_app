# Production settings. Copy to .env.production ON THE SERVER and fill in.
# Never commit .env.production. Email (SMTP) settings live in mailer/.env.

# Your domain. Its DNS A/AAAA record must point to the server, and ports 80
# and 443 must be reachable: Caddy then gets HTTPS certificates automatically.
DOMAIN=hearth.example.com
# Public URL; defaults to https://$DOMAIN. Only set it for non-standard ports.
# APP_URL=https://hearth.example.com

# MongoDB (only reachable inside Docker). Use a long random password:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MONGO_INITDB_ROOT_USERNAME=hearth
MONGO_INITDB_ROOT_PASSWORD=
MONGO_DATABASE=chores

# Shared secret between backend and mailer, at least 32 characters (new one for production):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MAILER_KEY=

# Optional: other host ports (e.g. when testing locally next to something else).
# HTTP_PORT=80
# HTTPS_PORT=443

# Only when the server's own nginx is in front (DEPLOY.md, "Behind an existing nginx"):
# COMPOSE_FILE=compose.prod.yaml:compose.nginx.yaml
# HEARTH_LOCAL_PORT=8087   # where nginx forwards to (127.0.0.1 only)
