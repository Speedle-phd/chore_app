# Site rules shared by Caddyfile (direct, automatic HTTPS) and
# Caddyfile.behind-proxy (behind the host's nginx). Imported, not used alone.

encode zstd gzip

# Everything the browser needs from the backend stays on this origin, so
# session cookies are first-party and no CORS is involved.
@backend path /api/* /uploads/* /socket.io/*
handle @backend {
	# Sets X-Forwarded-For (backend: TRUST_PROXY) and upgrades WebSockets.
	reverse_proxy backend:3000
}

# The single-page app: unknown paths fall back to index.html.
handle {
	root * /srv
	try_files {path} /index.html
	file_server
}

header {
	Strict-Transport-Security "max-age=31536000; includeSubDomains"
	X-Content-Type-Options "nosniff"
	Referrer-Policy "no-referrer"
	X-Frame-Options "DENY"
	Permissions-Policy "camera=(), microphone=(), geolocation=()"
	# Styles allow 'unsafe-inline' for React style attributes; scripts don't.
	Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss://{$DOMAIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	-Server
}

# Fingerprinted build assets can be cached forever; the page itself never.
@assets path /assets/*
header @assets Cache-Control "public, max-age=31536000, immutable"
@page path / /index.html
header @page Cache-Control "no-cache"
